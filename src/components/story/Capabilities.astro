---
const groups = [
  {
    th: 'วิศวกรรมไฟฟ้า',
    en: 'Electrical engineering',
    items: [
      'อ่านและตรวจสอบแบบไฟฟ้าเพื่อควบคุมงานหน้างาน',
      'ถอดแบบประมาณราคา (BOQ)',
      'ควบคุมงานติดตั้งระบบไฟฟ้าแสงสว่างและเดินสาย',
      'เขียนแบบทางวิศวกรรม',
    ],
    tools: 'AutoCAD',
  },
  {
    th: 'ข้อมูลและงานวิจัย',
    en: 'Research data',
    items: [
      'ลงรหัสข้อมูลจากแบบสอบถาม (Data coding)',
      'ตรวจสอบและทำความสะอาดข้อมูล (Data cleansing)',
      'จัดโครงสร้างฐานข้อมูลให้พร้อมวิเคราะห์ทางสถิติ',
      'วิเคราะห์และสรุปผลข้อมูล',
    ],
    tools: 'Excel, Python (กำลังพัฒนา), Database',
  },
  {
    th: 'เอกสารและระบบองค์กร',
    en: 'Operations',
    items: [
      'เอกสารจัดซื้อจัดจ้างและงานพัสดุ',
      'ติดตามงบประมาณค่าใช้จ่ายของแผนก',
      'จัดทำรายงานและสไลด์นำเสนอ',
      'ประสานงานระหว่างแผนก',
    ],
    tools: 'SAP, Microsoft Office, Canva',
  },
];
---
<section class="chapter skills" id="skills" data-chapter="ความสามารถ" data-tone="#e9eef1">
  <header class="chapter-head">
    <h2 class="chapter-title" data-node data-lines>ความสามารถ</h2>
    <p class="chapter-lead" data-lines>
      ทักษะที่ได้ใช้จริงจากงานวิศวกรรม งานวิจัย และงานในองค์กร
    </p>
  </header>
  <div class="skill-groups">
    {groups.map((g) => (
      <section class="skill-group" data-reveal>
        <h3>{g.th}<span class="skill-group-en">{g.en}</span></h3>
        <ul>
          {g.items.map((it) => <li>{it}</li>)}
        </ul>
        <p class="skill-tools"><strong>เครื่องมือ</strong> {g.tools}</p>
      </section>
    ))}
  </div>
</section>

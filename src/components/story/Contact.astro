---
import Icon from './Icon.astro';
---
<section class="chapter contact" id="contact" data-chapter="ติดต่อ" data-tone="#111418" data-theme="dark">
  <div class="contact-top">
    <p class="availability"><span class="live-dot" aria-hidden="true"></span>Available for new opportunities</p>
    <p class="local-time">Chiang Mai, Thailand <time class="clock" translate="no"></time></p>
  </div>

  <h2 class="contact-title" data-node>
    <span class="contact-line" data-drift="1">LET'S MAKE</span>
    <span class="contact-line contact-line--indent" data-drift="-1">SOMETHING</span>
    <span class="contact-line" data-drift="0.6">MEANINGFUL.</span>
  </h2>

  <div class="contact-intro">
    <p data-lines>หากคุณมีไอเดียหรือโปรเจกต์ที่น่าสนใจ สามารถติดต่อเข้ามาพูดคุยเพื่อสร้างสรรค์ผลงานนวัตกรรมใหม่ร่วมกันได้เลยครับ</p>
    <p class="signature" translate="no">Satayu Pongpan<br />Electrical Engineer</p>
  </div>

  <a href="mailto:satayu.pongpan@gmail.com" class="mail" data-cursor="ส่งอีเมล" data-wire-end>
    <span class="mail-label">Start a conversation</span>
    <span class="mail-address" translate="no">satayu.pongpan@gmail.com</span>
    <Icon name="arrow" />
  </a>

  <footer class="site-footer">
    <nav class="social" aria-label="Social media">
      <a href="https://www.facebook.com/satayu.pongpan.2024" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><Icon name="facebook" /></a>
      <a href="https://www.instagram.com/ddme36?igsh=YjltNTY3M29yZzFl&utm_source=qr" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><Icon name="instagram" /></a>
      <a href="https://line.me/ti/p/FY_E24MWyp" target="_blank" rel="noopener noreferrer" aria-label="Line"><Icon name="line" /></a>
    </nav>
    <p>Crafted with passion</p>
    <p>© 2026 Satayu Pongpan</p>
  </footer>
</section>

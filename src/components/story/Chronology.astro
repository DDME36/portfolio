---
// Chronological left → right so the horizontal ride reads as a timeline
const items = [
  { kind: 'การศึกษา', date: '2560 - 2563', title: 'วิทยาลัยเทคนิคแพร่', sub: 'ประกาศนียบัตรวิชาชีพ (ปวช.) สาขาไฟฟ้ากำลัง', desc: 'ปูพื้นฐานงานติดตั้งไฟฟ้าในและนอกอาคาร, การควบคุมมอเตอร์, ระบบควบคุมและโปรแกรมไฟฟ้า และหม้อแปลงไฟฟ้า พร้อมสร้างนวัตกรรมตู้เย็นเคลื่อนที่' },
  { kind: 'ฝึกงาน', date: '2562', title: 'โรงพยาบาลแพร่', sub: 'นักศึกษาฝึกงาน (ปวช.)', desc: 'ซ่อมบำรุงระบบไฟฟ้าและเครื่องใช้ไฟฟ้าในสถานพยาบาล ติดตั้งเดินสายระบบหลอดไฟและพัดลม ซ่อมแซมโทรศัพท์สื่อสารภายใน และปฏิบัติงานปีนขึ้นไปแก้ไขระบบสายไฟฟ้าบนเสาไฟฟ้าเป็นครั้งคราว' },
  { kind: 'การศึกษา', date: '2563 - 2567', title: 'มหาวิทยาลัยราชมงคลล้านนาเชียงใหม่', sub: 'วิศวกรรมศาสตรบัณฑิต สาขาวิศวกรรมไฟฟ้า (ไฟฟ้ากำลัง)', desc: 'ศึกษาเน้นด้านวิศวกรรมไฟฟ้ากำลัง ครอบคลุมระบบส่งจ่าย โครงข่ายอัจฉริยะ (Smart Grid) เทคโนโลยียานยนต์ไฟฟ้า (EV) และระบบพลังงานหมุนเวียน พร้อมทำโครงงานวิจัยศึกษาเครื่องปล่อยประจุความถี่สูง (HFSSTC)' },
  { kind: 'ฝึกงาน', date: '2567 - 2568', title: 'บริษัทรับเหมาไฟฟ้า', sub: 'นักศึกษาฝึกงาน (Site Engineer)', desc: 'ควบคุมงานติดตั้งระบบไฟฟ้าหน้างานตามโครงการและมหาวิทยาลัยต่าง ๆ ตรวจสอบแบบพิมพ์เขียวเพื่อคุมหน้างาน ต่อระบบหลอดไฟและสายไฟฟ้า ถอดแบบประมาณราคา (BOQ) และนำเสนอราคาโครงการต่อบริษัทคู่ค้า' },
  { kind: 'ทำงาน', date: '2567 (เมษายน - ธันวาคม)', title: 'การไฟฟ้าส่วนภูมิภาค (PEA)', sub: 'ลูกจ้าง (บริษัท สยามราชธานี จำกัด (มหาชน))', desc: 'จัดการงานเอกสารจัดซื้อจัดจ้างและงานพัสดุ ควบคุมการตัดงบประมาณค่าใช้จ่ายประจำแผนก พร้อมสนับสนุนงานของหัวหน้าแผนกอย่างรอบด้าน ทั้งการประสานงานติดต่อ จัดทำสไลด์นำเสนอผลงาน และส่งต่อประสานงานร่วมกับแผนกอื่น ๆ' },
  { kind: 'ทำงาน', date: '2568 (มกราคม) - ปัจจุบัน', title: 'ผู้ช่วยนักวิจัย', sub: 'Research Assistant', desc: 'ดำเนินการลงรหัสข้อมูล (Data Coding) จากแบบสอบถามตามโครงสร้างรหัสงานวิจัย ตรวจสอบคัดกรองและแก้ไขข้อมูลที่ผิดปกติ พร้อมทำความสะอาดข้อมูล (Data Cleansing) เพื่อจัดเตรียมฐานข้อมูลวิจัยส่งต่อให้นักวิจัยนำไปวิเคราะห์ผลเชิงสถิติต่อไป' },
];
---
<section class="chapter journey theme-navy grow" id="journey" data-chapter="เส้นทาง" data-theme="dark" style="--outer: var(--paper)">
  <div class="chapter-bg blueprint"></div>
  <div class="journey-inner">
    <header class="chapter-head">
      <h2 class="chapter-title" data-node data-lines>เส้นทางที่ผ่านมา</h2>
      <p class="chapter-lead" data-lines>ประวัติการศึกษาและประสบการณ์ทำงาน — บันทึกการเติบโตและการเปลี่ยนผ่านทักษะ</p>
    </header>
    <div class="journey-viewport">
      <div class="journey-rail" aria-hidden="true"><span class="journey-progress"></span></div>
      <ol class="journey-track">
        {items.map((it) => (
          <li class="journey-card">
            <span class="journey-node" aria-hidden="true"></span>
            <span class="journey-kind">{it.kind}</span>
            <p class="journey-date">{it.date}</p>
            <h3>{it.title}</h3>
            <p class="journey-sub">{it.sub}</p>
            <p class="journey-desc">{it.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

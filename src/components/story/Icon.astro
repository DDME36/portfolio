---
// Inline icon set — replaces the Font Awesome CDN (only these few are used)
interface Props { name: 'external' | 'facebook' | 'instagram' | 'line' | 'close' | 'prev' | 'next' | 'arrow'; }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'prev' && <path d="M15 5l-7 7 7 7" />}
  {name === 'next' && <path d="M9 5l7 7-7 7" />}
  {name === 'facebook' && <path d="M14 8.5V7c0-.8.3-1.3 1.4-1.3H17V3h-2.4C11.9 3 11 4.4 11 6.8v1.7H9V11h2v10h3V11h2.4l.4-2.5H14Z" class="fill" />}
  {name === 'instagram' && <g><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".9" class="fill" /></g>}
  {name === 'line' && <path d="M12 3.5c-5 0-9 3.2-9 7.2 0 3.6 3.2 6.6 7.5 7.1.3.1.7.2.8.5l.1 1-.1.9c0 .3.3.6.8.3 3.9-2.2 8.9-5.6 8.9-9.8 0-4-4-7.2-9-7.2Z" />}
</svg>

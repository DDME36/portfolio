---
import Icon from './Icon.astro';
---
<dialog class="lightbox" aria-label="ดูภาพขนาดใหญ่">
  <img class="lightbox-img" src="" alt="" />
  <button type="button" class="lightbox-btn lightbox-close" aria-label="ปิด"><Icon name="close" /></button>
  <button type="button" class="lightbox-btn lightbox-prev" aria-label="ภาพก่อนหน้า"><Icon name="prev" /></button>
  <button type="button" class="lightbox-btn lightbox-next" aria-label="ภาพถัดไป"><Icon name="next" /></button>
</dialog>

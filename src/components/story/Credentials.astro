---
const gallery = [
  { img: '/images/c1.webp', w: 1382, h: 1021, n: 1 },
  { img: '/images/c2.webp', w: 1400, h: 990, n: 2 },
  { img: '/images/c3.webp', w: 1400, h: 1082, n: 3 },
  { img: '/images/c4.webp', w: 1400, h: 1048, n: 4 },
];
---
<section class="chapter credentials theme-paper" id="credentials" data-chapter="ใบรับรอง">
  <div class="chapter-bg"></div>
  <header class="chapter-head">
    <h2 class="chapter-title" data-node data-lines>ใบรับรอง</h2>
    <p class="chapter-lead" data-lines>ใบประกาศนียบัตรและใบอนุญาตประกอบวิชาชีพ</p>
  </header>
  <ul class="cert-grid">
    {gallery.map((g) => (
      <li data-tilt-in>
        <button type="button" class="cert-item" data-lightbox={g.img} data-cursor="ขยายภาพ" aria-label={`ขยายภาพ Certificate ${g.n}`}>
          <img src={g.img} alt={`Certificate ${g.n}`} loading="lazy" decoding="async" width={g.w} height={g.h} />
        </button>
      </li>
    ))}
  </ul>
</section>

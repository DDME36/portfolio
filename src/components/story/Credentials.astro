---
const main = [
  { img: '/images/coe.webp', alt: 'ใบอนุญาต กว.', w: 1600, h: 1131, title: 'ใบอนุญาตประกอบวิชาชีพวิศวกรรมควบคุม', meta: ['สาขาวิศวกรรมไฟฟ้ากำลัง', 'ภาคีวิศวกร', 'ออกโดยสภาวิศวกร'], badge: 'กว.' },
  { img: '/images/toeic1.webp', alt: 'TOEIC', w: 1600, h: 710, title: 'TOEIC SCORE 560', meta: ['LISTENING 310, READING 250', '2568', 'ยืนยันความสามารถสื่อสารสากล'], badge: 'TOEIC' },
];
const gallery = [
  { img: '/images/c1.webp', w: 1382, h: 1021, n: 1 },
  { img: '/images/c2.webp', w: 1400, h: 990, n: 2 },
  { img: '/images/c3.webp', w: 1400, h: 1082, n: 3 },
  { img: '/images/c4.webp', w: 1400, h: 1048, n: 4 },
];
---
<section class="chapter credentials" id="credentials" data-chapter="ใบรับรอง" data-tone="#05090c">
  <header class="chapter-head">
    <h2 class="chapter-title" data-node data-lines>ใบรับรอง</h2>
    <p class="chapter-lead" data-lines>ใบประกาศนียบัตรและใบอนุญาตประกอบวิชาชีพ</p>
  </header>

  <h3 class="sub-heading" data-reveal>Professional credentials</h3>
  <div class="cert-main">
    {main.map((c) => (
      <article class="cert-card" data-reveal>
        <button type="button" class="cert-media" data-lightbox={c.img} data-cursor="ขยายภาพ" aria-label={`ขยายภาพ ${c.title}`}>
          <img src={c.img} alt={c.alt} loading="lazy" decoding="async" width={c.w} height={c.h} />
          <span class="cert-badge">{c.badge}</span>
        </button>
        <h4>{c.title}</h4>
        <ul class="cert-meta">{c.meta.map((m) => <li>{m}</li>)}</ul>
      </article>
    ))}
  </div>

  <div class="gallery" data-horizontal>
    <h3 class="sub-heading" data-reveal>Certificates gallery</h3>
    <div class="gallery-viewport">
      <ul class="gallery-track">
        {gallery.map((g) => (
          <li>
            <button type="button" class="gallery-item" data-lightbox={g.img} data-cursor="ขยายภาพ" aria-label={`ขยายภาพ Certificate ${g.n}`}>
              <img src={g.img} alt={`Certificate ${g.n}`} loading="lazy" decoding="async" width={g.w} height={g.h} />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

---
const links = [
  ['#services', 'สิ่งที่ผมทำ'],
  ['#work', 'ผลงาน'],
  ['#experience', 'ประสบการณ์'],
  ['#credentials', 'ใบรับรอง'],
  ['#contact', 'ติดต่อ'],
];
---

<header class="site-header">
  <a class="site-name" href="#top" aria-label="Satayu Pongpan กลับด้านบน">Satayu®</a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle data-magnet><span data-menu-label>Menu</span><i aria-hidden="true"></i></button>
</header>

<nav class="menu" id="menu" aria-label="เมนูหลัก" inert>
  <ol>
    {links.map(([href, label], i) => (
      <li><a class="menu-link" href={href} style={`--i:${i}`} data-menu-link><span>{label}</span></a></li>
    ))}
  </ol>
  <div class="menu-foot">
    <a href="mailto:satayu.pongpan@gmail.com">satayu.pongpan@gmail.com</a>
    <span>วิศวกรไฟฟ้ากำลัง · ภาคีวิศวกร</span>
  </div>
</nav>

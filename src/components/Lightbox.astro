<!-- Image Lightbox Modal -->
<dialog class="image-dialog" id="imageLightbox" aria-labelledby="lightboxCaption">
  <div class="dialog-top">
    <p id="lightboxCaption">ภาพผลงาน</p>
    <button type="button" class="dialog-close" data-dialog-close>ปิดภาพ</button>
  </div>
  <img class="dialog-image" id="lightboxImage" alt="" />
  <div class="dialog-bottom">
    <button type="button" data-image-prev aria-label="ดูภาพก่อนหน้า">ภาพก่อนหน้า</button>
    <p id="lightboxCounter" aria-live="polite"></p>
    <button type="button" data-image-next aria-label="ดูภาพถัดไป">ภาพถัดไป</button>
  </div>
</dialog>

---
const certificates = [
  { image: 'c1.png', width: 1382, height: 1021, label: 'ใบประกาศนียบัตรฉบับที่ 1' },
  { image: 'c2.png', width: 3308, height: 2339, label: 'ใบประกาศนียบัตรฉบับที่ 2' },
  { image: 'c3.png', width: 2200, height: 1700, label: 'ใบประกาศนียบัตรฉบับที่ 3' },
  { image: 'c4.png', width: 1603, height: 1200, label: 'ใบประกาศนียบัตรฉบับที่ 4' },
];
---

<section class="section credentials" id="credentials" aria-labelledby="credentials-title">
  <div class="sec-head">
    <h2 class="sec-title rise" id="credentials-title"><span>ใบอนุญาต<br />และใบรับรอง</span></h2>
  </div>

  <div class="cred-main">
    <article class="cred" data-reveal>
      <a class="cred-pic" href="/images/coe.jpg" data-lightbox data-gallery="credentials" data-cursor="ขยาย" data-caption="ใบอนุญาตประกอบวิชาชีพวิศวกรรมควบคุม" aria-label="ดูใบอนุญาต กว. ขนาดใหญ่">
        <img src="/images/coe.jpg" alt="ใบอนุญาตประกอบวิชาชีพวิศวกรรมควบคุม สาขาวิศวกรรมไฟฟ้ากำลัง" width="2629" height="1858" loading="lazy" decoding="async" />
      </a>
      <h3>ใบอนุญาต กว.</h3>
      <p>ภาคีวิศวกร สาขาวิศวกรรมไฟฟ้ากำลัง<br /><span class="muted">ออกโดยสภาวิศวกร</span></p>
    </article>
    <article class="cred" data-reveal style="--d:1">
      <a class="cred-pic" href="/images/toeic1.png" data-lightbox data-gallery="credentials" data-cursor="ขยาย" data-caption="ใบรายงานผลคะแนน TOEIC 560" aria-label="ดูผลคะแนน TOEIC ขนาดใหญ่">
        <img src="/images/toeic1.png" alt="ใบรายงานผลคะแนน TOEIC รวม 560 คะแนน" width="2480" height="1100" loading="lazy" decoding="async" />
      </a>
      <h3>TOEIC 560</h3>
      <dl class="score">
        <div><dt lang="en">Listening</dt><dd>310</dd></div>
        <div><dt lang="en">Reading</dt><dd>250</dd></div>
        <div><dt>สอบปี</dt><dd>2568</dd></div>
      </dl>
    </article>
  </div>

  <h3 class="certs-title" data-reveal>ใบประกาศนียบัตรเพิ่มเติม</h3>
  <div class="certs">
    {certificates.map(({ image, width, height, label }, i) => (
      <a href={`/images/${image}`} data-lightbox data-gallery="credentials" data-cursor="ขยาย" data-caption={label} aria-label={`ดู${label}ขนาดใหญ่`} data-reveal style={`--d:${i}`}>
        <span class="cert-pic"><img src={`/images/${image}`} alt={label} width={width} height={height} loading="lazy" decoding="async" /></span>
        <span>{label}</span>
      </a>
    ))}
  </div>
</section>

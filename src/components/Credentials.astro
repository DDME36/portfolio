---
const certificates = [
  { image: 'c1.png', width: 1382, height: 1021, label: 'ใบประกาศนียบัตรฉบับที่ 1' },
  { image: 'c2.png', width: 3308, height: 2339, label: 'ใบประกาศนียบัตรฉบับที่ 2' },
  { image: 'c3.png', width: 2200, height: 1700, label: 'ใบประกาศนียบัตรฉบับที่ 3' },
  { image: 'c4.png', width: 1603, height: 1200, label: 'ใบประกาศนียบัตรฉบับที่ 4' },
];
---

<!-- Section 6: Certifications -->
<!-- Certificates Scrolling Gallery -->
<!-- Duplicate for seamless loop -->
<!-- Main Certifications -->

<section class="credentials-section section-space" id="section6" aria-labelledby="credentials-title">
  <div class="page-width">
    <h2 class="reveal" id="credentials-title">ใบอนุญาตและใบรับรอง</h2>
    <div class="credential-layout">
      <article class="credential licence-credential">
        <a class="credential-picture reveal-picture" href="/images/coe.jpg" data-lightbox data-gallery="credentials" data-caption="ใบอนุญาตประกอบวิชาชีพวิศวกรรมควบคุม" aria-label="ดูใบอนุญาต กว. ขนาดใหญ่">
          <img src="/images/coe.jpg" alt="ใบอนุญาตประกอบวิชาชีพวิศวกรรมควบคุม สาขาวิศวกรรมไฟฟ้ากำลัง" width="2629" height="1858" loading="lazy" decoding="async" />
          <span class="picture-action" aria-hidden="true">ขยายภาพ</span>
        </a>
        <div class="credential-copy">
          <h3 class="reveal">ใบอนุญาต กว.</h3>
          <p class="reveal">ภาคีวิศวกร<br />สาขาวิศวกรรมไฟฟ้ากำลัง</p>
          <p class="credential-issuer reveal">ออกโดยสภาวิศวกร</p>
        </div>
      </article>
      <article class="credential toeic-credential">
        <a class="credential-picture reveal-picture" href="/images/toeic1.png" data-lightbox data-gallery="credentials" data-caption="ใบรายงานผลคะแนน TOEIC 560" aria-label="ดูผลคะแนน TOEIC ขนาดใหญ่">
          <img src="/images/toeic1.png" alt="ใบรายงานผลคะแนน TOEIC รวม 560 คะแนน" width="2480" height="1100" loading="lazy" decoding="async" />
          <span class="picture-action" aria-hidden="true">ขยายภาพ</span>
        </a>
        <div class="credential-copy">
          <h3 class="reveal">TOEIC 560</h3>
          <dl class="score-breakdown reveal">
            <div><dt lang="en">Listening</dt><dd>310</dd></div>
            <div><dt lang="en">Reading</dt><dd>250</dd></div>
          </dl>
          <p class="credential-issuer reveal">สอบปี 2568</p>
        </div>
      </article>
    </div>
    <div class="certificate-disclosure">
      <h3 class="reveal">ใบประกาศนียบัตรเพิ่มเติม</h3>
      <div class="certificate-gallery">
        {certificates.map(({ image, width, height, label }) => (
          <a class="reveal-row" href={`/images/${image}`} data-lightbox data-gallery="credentials" data-caption={label} aria-label={`ดู${label}ขนาดใหญ่`}>
            <img src={`/images/${image}`} alt={label} width={width} height={height} loading="lazy" decoding="async" />
            <span>{label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

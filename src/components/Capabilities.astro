---
const groups = [
  { title: 'งานเขียนแบบไฟฟ้า', tools: [
    { name: 'AutoCAD', logo: 'autocad', description: 'งานเขียนแบบไฟฟ้า' },
  ] },
  { title: 'เอกสารและการนำเสนอ', tools: [
    { name: 'Word', logo: 'word', description: 'เอกสารและรายงาน' },
    { name: 'PowerPoint', logo: 'powerpoint', description: 'สไลด์นำเสนอ' },
    { name: 'Excel', logo: 'excel', description: 'ตารางคำนวณและสรุปข้อมูล' },
  ] },
  { title: 'ข้อมูลและระบบงาน', tools: [
    { name: 'Python', logo: 'python', description: 'กำลังเรียนรู้' },
    { name: 'SAP', logo: 'sap', description: 'ระบบงานองค์กร', wide: true },
  ] },
];
---

<!-- Section 3: Capabilities -->

<section class="capabilities-section section-space page-width" id="section3" aria-labelledby="capabilities-title">
  <div class="capabilities-heading">
    <h2 class="reveal" id="capabilities-title">เครื่องมือที่ใช้</h2>
    <p class="section-intro reveal">ใช้ในงานเขียนแบบ ทำเอกสาร และจัดการข้อมูล</p>
  </div>
  <div class="tool-groups">
    {groups.map(({ title, tools }) => (
      <div class:list={['tool-group', { 'tool-group-drawing': tools.length === 1 }]}>
        <h3 class="reveal">{title}</h3>
        <ul class="tool-list" style={`--tool-columns: ${tools.length}`}>
          {tools.map(({ name, logo, description, wide }) => (
            <li class="tool-item reveal-row">
              <img src={`/images/tools/${logo}.svg`} alt="" width="160" height="88" loading="lazy" decoding="async" class:list={{ 'tool-logo-wide': wide }} />
              <h4>{name}</h4>
              <p>{description}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

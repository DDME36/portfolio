<!-- Section 4: Education & Work -->
<section class="section" id="section4">
  <div class="diagonal-shape"></div>
  <div class="morph-shape shape-2 layer-shape" data-speed="0.5"></div>
  <div class="morph-shape shape-3 layer-shape" data-speed="0.3"></div>
  <div class="geo-shape geo-square layer-shape" data-speed="0.4"></div>
  <div class="geo-shape geo-triangle layer-shape" data-speed="0.6"></div>
  <div class="content">
    <div class="section-label">04 — CHRONOLOGY</div>
    <h1>CHRONOLOGY</h1>
    <p class="section-subtitle">ประวัติการศึกษาและประสบการณ์ทำงาน — บันทึกการเติบโตและการเปลี่ยนผ่านทักษะ</p>
    <div class="education-grid">
      <div class="education-section">
        <h3>
          <i class="fas fa-graduation-cap"></i>
          การศึกษา
        </h3>
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-date">2563 - 2567</div>
            <h4 class="timeline-title">
              มหาวิทยาลัยราชมงคลล้านนาเชียงใหม่
            </h4>
            <p class="timeline-subtitle">
              วิศวกรรมศาสตรบัณฑิต สาขาวิศวกรรมไฟฟ้า (ไฟฟ้ากำลัง)
            </p>
            <p class="timeline-description">
              ศึกษาเน้นด้านวิศวกรรมไฟฟ้ากำลัง ครอบคลุมระบบส่งจ่าย โครงข่ายอัจฉริยะ (Smart Grid) เทคโนโลยียานยนต์ไฟฟ้า (EV) และระบบพลังงานหมุนเวียน พร้อมทำโครงงานวิจัยศึกษาเครื่องปล่อยประจุความถี่สูง (HFSSTC)
            </p>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-date">2560 - 2563</div>
            <h4 class="timeline-title">วิทยาลัยเทคนิคแพร่</h4>
            <p class="timeline-subtitle">
              ประกาศนียบัตรวิชาชีพ (ปวช.) สาขาไฟฟ้ากำลัง
            </p>
            <p class="timeline-description">
              ปูพื้นฐานงานติดตั้งไฟฟ้าในและนอกอาคาร, การควบคุมมอเตอร์, ระบบควบคุมและโปรแกรมไฟฟ้า และหม้อแปลงไฟฟ้า พร้อมสร้างนวัตกรรมตู้เย็นเคลื่อนที่
            </p>
          </div>
        </div>
      </div>
      <div class="education-section">
        <h3>
          <i class="fas fa-briefcase"></i>
          ประสบการณ์ทำงาน
        </h3>
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-date">2568 (มกราคม) - ปัจจุบัน</div>
            <h4 class="timeline-title">ผู้ช่วยนักวิจัย</h4>
            <p class="timeline-subtitle">
              Research Assistant
            </p>
            <p class="timeline-description">
              ดำเนินการลงรหัสข้อมูล (Data Coding) จากแบบสอบถามตามโครงสร้างรหัสงานวิจัย ตรวจสอบคัดกรองและแก้ไขข้อมูลที่ผิดปกติ พร้อมทำความสะอาดข้อมูล (Data Cleansing) เพื่อจัดเตรียมฐานข้อมูลวิจัยส่งต่อให้นักวิจัยนำไปวิเคราะห์ผลเชิงสถิติต่อไป
            </p>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-date">2567 (เมษายน - ธันวาคม)</div>
            <h4 class="timeline-title">การไฟฟ้าส่วนภูมิภาค (PEA)</h4>
            <p class="timeline-subtitle">
              ลูกจ้าง (บริษัท สยามราชธานี จำกัด (มหาชน))
            </p>
            <p class="timeline-description">
              จัดการงานเอกสารจัดซื้อจัดจ้างและงานพัสดุ ควบคุมการตัดงบประมาณค่าใช้จ่ายประจำแผนก พร้อมสนับสนุนงานของหัวหน้าแผนกอย่างรอบด้าน ทั้งการประสานงานติดต่อ จัดทำสไลด์นำเสนอผลงาน และส่งต่อประสานงานร่วมกับแผนกอื่น ๆ
            </p>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-date">2567 - 2568</div>
            <h4 class="timeline-title">บริษัทรับเหมาไฟฟ้า</h4>
            <p class="timeline-subtitle">นักศึกษาฝึกงาน (Site Engineer)</p>
            <p class="timeline-description">
              ควบคุมงานติดตั้งระบบไฟฟ้าหน้างานตามโครงการและมหาวิทยาลัยต่าง ๆ ตรวจสอบแบบพิมพ์เขียวเพื่อคุมหน้างาน ต่อระบบหลอดไฟและสายไฟฟ้า ถอดแบบประมาณราคา (BOQ) และนำเสนอราคาโครงการต่อบริษัทคู่ค้า
            </p>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-date">2562</div>
            <h4 class="timeline-title">โรงพยาบาลแพร่</h4>
            <p class="timeline-subtitle">นักศึกษาฝึกงาน (ปวช.)</p>
            <p class="timeline-description">
              ซ่อมบำรุงระบบไฟฟ้าและเครื่องใช้ไฟฟ้าในสถานพยาบาล ติดตั้งเดินสายระบบหลอดไฟและพัดลม ซ่อมแซมโทรศัพท์สื่อสารภายใน และปฏิบัติงานปีนขึ้นไปแก้ไขระบบสายไฟฟ้าบนเสาไฟฟ้าเป็นครั้งคราว
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="scroll-hint">
    <i class="fas fa-chevron-down"></i>
  </div>
</section>

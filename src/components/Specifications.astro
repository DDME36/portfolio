---
import { Image } from 'astro:assets';
import zentyrCover from '../assets/zentyr-cover-v1.png';
import teslaConcept from '../assets/hfsstc-concept-v4.png';
import fridgeConcept from '../assets/mobile-fridge-concept-v5.png';
---

<!-- Section 5: Projects -->
<section class="work-section section-space" id="section5" aria-labelledby="work-title">
  <div class="page-width">
    <div class="work-heading">
      <h2 class="reveal" id="work-title">งานที่ลงมือทำ</h2>
      <p class="section-intro reveal">โครงงานที่ทำเองตั้งแต่ ปวช.<br />จนถึงปริญญาตรี</p>
    </div>

    <article class="project project-feature">
      <a class="project-picture reveal-picture" href={teslaConcept.src} data-lightbox data-gallery="projects" data-caption="ขดลวดเทสลา: ภาพจำลองแนวคิด ไม่ใช่ภาพชิ้นงานจริงหรือแบบสำหรับสร้าง" aria-label="ดูภาพจำลองแนวคิดขดลวดเทสลาขนาดใหญ่">
        <Image src={teslaConcept} alt="ภาพจำลองจากภาพอ้างอิง แสดงขดลวดแดงบนบอร์ดวงจร ฮีตซิงก์ พัดลม และเปลวพลาสมาที่ปลายหัวทดลองแยก" widths={[480, 800, 1200, 1536]} sizes="(max-width: 900px) 100vw, 60vw" format="webp" quality={85} loading="lazy" decoding="async" />
        <span class="picture-action" aria-hidden="true">ขยายภาพ</span>
      </a>
      <div class="project-copy">
        <h3 class="reveal">ขดลวดเทสลา</h3>
        <p class="project-context reveal">โครงงานปริญญาตรี (HFSSTC)</p>
        <p class="project-image-note">ภาพประกอบจำลอง ไม่ใช่ภาพถ่ายชิ้นงานจริง</p>
        <p class="reveal">ศึกษาวงจรความถี่สูงและคำนวณค่าที่ใช้ จากนั้นทดลองเปลี่ยนขดลวดเหนี่ยวนำและหัวอิเล็กโทรดหลายแบบ เพื่อดูว่าพลาสมาที่ได้ต่างกันอย่างไร แล้วสรุปผล</p>
      </div>
    </article>

    <article class="project project-secondary">
      <div class="project-copy">
        <h3 class="reveal">ตู้เย็นเคลื่อนที่</h3>
        <p class="project-context reveal">สิ่งประดิษฐ์สมัยเรียน ปวช.</p>
        <p class="project-image-note">ภาพประกอบจำลองจากรูปชิ้นงานจริง</p>
        <p class="reveal">ติดตั้งระบบทำความเย็นเข้ากับถังแช่บนรถเข็น ให้ตู้เย็นย้ายไปใช้ที่ไหนก็ได้</p>
        <p class="reveal">ผมดัดแปลงรถเข็นให้รับน้ำหนักถังแช่ วางชุดทำความเย็นกับด้ามเข็นไว้ด้านหลังใกล้บานพับฝา ส่วนตู้ควบคุมไฟฟ้าและอุณหภูมิอยู่ที่มุมหลังด้านขวา และเดินสายทั้งหมดไว้ในตู้</p>
      </div>
      <a class="project-picture reveal-picture" href={fridgeConcept.src} data-lightbox data-gallery="projects" data-caption="ตู้เย็นเคลื่อนที่: ภาพจำลองจากรูปเดิมและรายละเอียดชิ้นงาน ไม่ใช่ภาพถ่ายจริง" aria-label="ดูภาพจำลองตู้เย็นเคลื่อนที่ขนาดใหญ่">
        <Image src={fridgeConcept} alt="ภาพจำลองมุมด้านหน้าเฉียงขวาของถังแช่สีน้ำเงินบนรถเข็น เห็นตัวล็อกฝาด้านหน้า กล่องควบคุมสีขาวด้านขวา และด้ามเข็นเอนไปด้านหลัง โดยชุดทำความเย็นอยู่หลังตู้" widths={[480, 800, 1200, 1536]} sizes="(max-width: 600px) 100vw, 50vw" format="webp" quality={85} loading="lazy" decoding="async" />
        <span class="picture-action" aria-hidden="true">ขยายภาพ</span>
      </a>
    </article>

    <article class="website-project reveal">
      <div class="website-project-content">
        <Image src={zentyrCover} alt="ภาพปก Zentyr.online Creative Tech Lab พร้อม ZenSend, ZenLoad และ ZenBot" widths={[480, 800, 1200]} sizes="(max-width: 600px) 100vw, 50vw" format="webp" quality={82} loading="lazy" decoding="async" />
        <div>
          <h3>เว็บไซต์ส่วนตัว</h3>
          <p>งานนอกเวลาที่ผมทำเอง รวมเว็บแอปและเครื่องมือเล็ก ๆ พร้อมบันทึกเบื้องหลังการพัฒนา</p>
          <a href="https://zentyr.online/" target="_blank" rel="noopener noreferrer">เยี่ยมชม Zentyr.online</a>
        </div>
      </div>
    </article>
  </div>
</section>

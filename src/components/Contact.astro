---
import '../styles/contact-editorial.css';
import '../styles/contact-social-fix.css';
---

<section class="section contact-editorial" id="section7">
  <div class="contact-orbit orbit-one" aria-hidden="true"></div>
  <div class="contact-orbit orbit-two" aria-hidden="true"></div>
  <div class="contact-edge-note" aria-hidden="true">CHIANG MAI · THAILAND · GMT+7</div>

  <div class="content contact-editorial-inner">
    <header class="contact-editorial-head">
      <div class="section-label">07 — CONTACT</div>
      <div class="contact-availability"><i></i><span>Available for new opportunities</span></div>
    </header>

    <div class="contact-editorial-copy">
      <h1 class="contact-editorial-title"><span>LET'S MAKE</span><span class="contact-outline">SOMETHING</span><span>MEANINGFUL.</span></h1>
      <div class="contact-editorial-intro">
        <p>หากคุณมีไอเดียหรือโปรเจกต์ที่น่าสนใจ สามารถติดต่อเข้ามาพูดคุยเพื่อสร้างสรรค์ผลงานนวัตกรรมใหม่ร่วมกันได้เลยครับ</p>
        <span class="contact-signature">Satayu Pongpan<br />Electrical Engineer</span>
      </div>
    </div>

    <a href="mailto:satayu.pongpan@gmail.com" class="contact-mail-row magnetic-item" data-cursor="MAIL">
      <span class="mail-label">Start a conversation</span><strong>satayu.pongpan@gmail.com</strong><span class="mail-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M7 17 17 7M9 7h8v8"></path></svg></span>
    </a>

    <footer class="contact-editorial-footer">
      <div class="contact-social-heading">Find me online</div>
      <nav class="contact-social-grid" aria-label="Social media">
        <a href="https://www.facebook.com/satayu.pongpan.2024" target="_blank" rel="noopener noreferrer" class="social-button facebook" data-cursor="LINK" aria-label="Facebook">
          <i class="fab fa-facebook-f"></i>
        </a>
        <a href="https://www.instagram.com/ddme36?igsh=YjltNTY3M29yZzFl&utm_source=qr" target="_blank" rel="noopener noreferrer" class="social-button instagram" data-cursor="LINK" aria-label="Instagram">
          <i class="fab fa-instagram"></i>
        </a>
        <a href="https://line.me/ti/p/FY_E24MWyp" target="_blank" rel="noopener noreferrer" class="social-button line" data-cursor="LINK" aria-label="Line">
          <i class="fab fa-line"></i>
        </a>
      </nav>
      <div class="contact-meta"><span>CRAFTED WITH PASSION</span><span>© 2026 Satayu Pongpan</span></div>
    </footer>
  </div>
</section>

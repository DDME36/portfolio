---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Expand from '../components/Expand.astro';
import Marquee from '../components/Marquee.astro';
import Services from '../components/Services.astro';
import Numbers from '../components/Numbers.astro';
import Work from '../components/Work.astro';
import Chronology from '../components/Chronology.astro';
import Credentials from '../components/Credentials.astro';
import Contact from '../components/Contact.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Layout>
  <a href="#main-container" class="skip-link">ข้ามไปยังเนื้อหา</a>
  <Header />
  <main id="main-container" tabindex="-1">
    <Hero />
    <Statement />
    <Expand />
    <Marquee />
    <Services />
    <Numbers />
    <Work />
    <Chronology />
    <Credentials />
    <Contact />
  </main>
  <Lightbox />
</Layout>

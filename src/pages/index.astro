---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Specifications from '../components/Specifications.astro';
import About from '../components/About.astro';
import Capabilities from '../components/Capabilities.astro';
import Credentials from '../components/Credentials.astro';
import Chronology from '../components/Chronology.astro';
import Contact from '../components/Contact.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Layout>
  <a href="#main-container" class="skip-link">ข้ามไปยังเนื้อหา</a>
  <Header />
  <main id="main-container" tabindex="-1">
    <Hero />
    <Specifications />
    <About />
    <Capabilities />
    <Credentials />
    <Chronology />
    <Contact />
  </main>
  <Lightbox />
</Layout>

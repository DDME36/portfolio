---
import Layout from '../layouts/Layout.astro';
import Header from '../components/story/Header.astro';
import Cursor from '../components/story/Cursor.astro';
import Hero from '../components/story/Hero.astro';
import About from '../components/story/About.astro';
import Bento from '../components/story/Bento.astro';
import Chronology from '../components/story/Chronology.astro';
import Projects from '../components/story/Projects.astro';
import Credentials from '../components/story/Credentials.astro';
import Contact from '../components/story/Contact.astro';
import Lightbox from '../components/story/Lightbox.astro';
---

<Layout>
  <Header />
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="field-grid" aria-hidden="true"></div>
  <main id="main" class="story">
    <svg class="wire" aria-hidden="true" focusable="false">
      <path class="wire-base" />
      <path class="wire-live" />
      <g class="wire-nodes"></g>
      <circle class="wire-tip" r="4" />
    </svg>
    <!-- The portrait that morphs between its slots as you scroll -->
    <div class="morph" aria-hidden="true"><img src="/images/profile.webp" alt="" width="768" height="768" decoding="async" /></div>
    <Hero />
    <About />
    <Bento />
    <Chronology />
    <Projects />
    <Credentials />
    <Contact />
  </main>
  <Cursor />
  <Lightbox />
</Layout>

---
import '@fontsource/ibm-plex-sans-thai/300.css';
import '@fontsource/ibm-plex-sans-thai/400.css';
import '@fontsource/ibm-plex-sans-thai/500.css';
import '@fontsource/ibm-plex-sans-thai/700.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ศตายุ พ้องพาน - วิศวกรไฟฟ้า | Satayu Pongpan - Electrical Engineer",
  description = "ศตายุ พ้องพาน (Satayu Pongpan) วิศวกรไฟฟ้า กว. และผู้ช่วยนักวิจัย มีประสบการณ์ด้านการจัดการฐานข้อมูลวิจัย Data Cleaning และเครื่องมือ AI"
} = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050608" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="ศตายุ พ้องพาน, Satayu Pongpan, วิศวกรไฟฟ้า, ผู้ช่วยนักวิจัย, Research Assistant, Electrical Engineer, กว., Data Analysis, Database, AI, Python, AutoCAD, มหาวิทยาลัยราชมงคลล้านนา, RMUTL"
    />
    <meta name="author" content="ศตายุ พ้องพาน (Satayu Pongpan)" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://punn.site/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://punn.site/images/profile.png" />
    <meta property="og:locale" content="th_TH" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://punn.site/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://punn.site/images/profile.png" />

    <link rel="canonical" href="https://punn.site/" />

    <!-- Flag motion before first paint so the hero intro never flashes -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <slot />

    <script src="../scripts/main.js"></script>

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "ศตายุ พ้องพาน",
        "alternateName": "Satayu Pongpan",
        "url": "https://punn.site",
        "image": "https://punn.site/images/profile.png",
        "jobTitle": "วิศวกรไฟฟ้า (Electrical Engineer)",
        "description": "วิศวกรไฟฟ้าที่มีใบประกอบวิชาชีพวิศวกรรมควบคุม กำลังเรียนรู้การประยุกต์ใช้ AI และเทคโนโลยีใหม่ๆ",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "มหาวิทยาลัยราชมงคลล้านนา เชียงใหม่",
          "alternateName": "Rajamangala University of Technology Lanna Chiang Mai"
        },
        "hasCredential": [
          {
            "@type": "EducationalOccupationalCredential",
            "name": "ใบประกอบวิชาชีพวิศวกรรมควบคุม (กว.)",
            "credentialCategory": "Professional License",
            "recognizedBy": { "@type": "Organization", "name": "สภาวิศวกร" }
          }
        ],
        "knowsAbout": [
          "วิศวกรรมไฟฟ้า",
          "Electrical Engineering",
          "AutoCAD",
          "Excel",
          "Python",
          "AI Tools",
          "Data Analysis"
        ],
        "sameAs": ["https://punn.site"]
      }
    </script>
  </body>
</html>

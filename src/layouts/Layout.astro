---
import '../styles/main.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "ศตายุ พ้องพาน - วิศวกรไฟฟ้า | Satayu Pongpan - Electrical Engineer",
  description = "ศตายุ พ้องพาน (Satayu Pongpan) วิศวกรไฟฟ้า กว. และผู้ช่วยนักวิจัย มีประสบการณ์ด้านการจัดการฐานข้อมูลวิจัย Data Cleaning และเครื่องมือ AI"
} = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />

    <!-- Preconnect for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#030305" />
    <link rel="apple-touch-icon" href="/images/profile.png" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="ศตายุ พ้องพาน, Satayu Pongpan, วิศวกรไฟฟ้า, ผู้ช่วยนักวิจัย, Research Assistant, Electrical Engineer, กว., Data Analysis, Database, AI, Python, AutoCAD, มหาวิทยาลัยราชมงคลล้านนา, RMUTL"
    />
    <meta name="author" content="ศตายุ พ้องพาน (Satayu Pongpan)" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://punn.site/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://punn.site/images/profile.png" />
    <meta property="og:locale" content="th_TH" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://punn.site/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://punn.site/images/profile.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://punn.site/" />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;900&family=Kanit:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body>
    <slot />

    <script src="../scripts/script.js"></script>

    <!-- JSON-LD Structured Data for SEO -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "ศตายุ พ้องพาน",
        "alternateName": "Satayu Pongpan",
        "url": "https://punn.site",
        "image": "https://punn.site/images/profile.png",
        "jobTitle": "วิศวกรไฟฟ้า (Electrical Engineer)",
        "description": "วิศวกรไฟฟ้าที่มีใบประกอบวิชาชีพวิศวกรรมควบคุม กำลังเรียนรู้การประยุกต์ใช้ AI และเทคโนโลยีใหม่ๆ",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "มหาวิทยาลัยราชมงคลล้านนา เชียงใหม่",
          "alternateName": "Rajamangala University of Technology Lanna Chiang Mai"
        },
        "hasCredential": [
          {
            "@type": "EducationalOccupationalCredential",
            "name": "ใบประกอบวิชาชีพวิศวกรรมควบคุม (กว.)",
            "credentialCategory": "Professional License",
            "recognizedBy": {
              "@type": "Organization",
              "name": "สภาวิศวกร"
            }
          }
        ],
        "knowsAbout": [
          "วิศวกรรมไฟฟ้า",
          "Electrical Engineering",
          "AutoCAD",
          "Excel",
          "Python",
          "AI Tools",
          "Data Analysis"
        ],
        "sameAs": ["https://punn.site"]
      }
    </script>
  </body>
</html>

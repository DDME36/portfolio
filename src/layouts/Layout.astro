---
import '../styles/fonts.css';
import '../styles/site.css';
import { getImage } from 'astro:assets';
import heroArtwork from '../assets/power-busbar-v1.png';

const socialImage = await getImage({ src: heroArtwork, width: 1200, format: 'webp' });
const socialImageUrl = new URL(socialImage.src, 'https://zentyr.online/').href;

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  noindex = false,
  title = "ศตายุ พ้องพาน | วิศวกรไฟฟ้า",
  description = "ศตายุ พ้องพาน (Satayu Pongpan) วิศวกรไฟฟ้ากำลัง มีใบอนุญาต กว. ระดับภาคีวิศวกร พร้อมประสบการณ์อ่านแบบ งานติดตั้งไฟฟ้า และถอดแบบประมาณราคา BOQ"
} = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>

    <!-- Preconnect for faster font loading -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/kanit/kanit-500-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/kanit/kanit-500-thai.woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f3ef" />
    <link rel="apple-touch-icon" href="/images/profile.png" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="ศตายุ พ้องพาน, Satayu Pongpan, วิศวกรไฟฟ้า, วิศวกรรมไฟฟ้ากำลัง, Electrical Engineer, กว., ภาคีวิศวกร, AutoCAD, BOQ, งานติดตั้งไฟฟ้า, RMUTL"
    />
    <meta name="author" content="ศตายุ พ้องพาน (Satayu Pongpan)" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zentyr.online/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="ภาพประกอบจำลองบัสบาร์ทองแดงและอุปกรณ์ตู้ไฟ สำหรับเว็บไซต์ศตายุ พ้องพาน" />
    <meta property="og:locale" content="th_TH" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://zentyr.online/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageUrl} />

    <!-- Canonical URL -->
    {!noindex && <link rel="canonical" href="https://zentyr.online/" />}
  </head>
  <body>
    <slot />

    <script src="../scripts/site.js"></script>

    <!-- JSON-LD Structured Data for SEO -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "ศตายุ พ้องพาน",
        "alternateName": "Satayu Pongpan",
        "url": "https://zentyr.online/",
        "jobTitle": "วิศวกรไฟฟ้า (Electrical Engineer)",
        "description": "วิศวกรไฟฟ้ากำลัง มีใบอนุญาต กว. ระดับภาคีวิศวกร มีประสบการณ์อ่านแบบ งานติดตั้งไฟฟ้า และถอดแบบประมาณราคา",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "มหาวิทยาลัยราชมงคลล้านนา เชียงใหม่",
          "alternateName": "Rajamangala University of Technology Lanna Chiang Mai"
        },
        "hasCredential": [
          {
            "@type": "EducationalOccupationalCredential",
            "name": "ใบประกอบวิชาชีพวิศวกรรมควบคุม (กว.)",
            "credentialCategory": "Professional License",
            "recognizedBy": {
              "@type": "Organization",
              "name": "สภาวิศวกร"
            }
          }
        ],
        "knowsAbout": [
          "วิศวกรรมไฟฟ้า",
          "Electrical Engineering",
          "AutoCAD",
          "Excel",
          "Electrical Power Engineering",
          "Electrical Installation",
          "Bill of Quantities"
        ],
        "sameAs": ["https://zentyr.online/"]
      }
    </script>
  </body>
</html>
